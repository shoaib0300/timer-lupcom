{
    "name": "lupcom/timer",
    "description": "Project and task time tracking application",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "dompdf/dompdf": "^3.0",
        "nikic/fast-route": "^1.3",
        "twig/twig": "^3.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Timer\\": "src/"
        }
    },
    "scripts": {
        "migrate": "php bin/console migrate",
        "migrate:rollback": "php bin/console migrate:rollback",
        "cache:clear": "php bin/console cache:clear",
        "test": "php tests/soll_working_time_test.php",
        "deploy": "bash bin/deploy.sh"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
