{% extends 'layouts/auth.html.twig' %}

{% block title %}{{ trans('auth.login_title') }}{% endblock %}

{% block content %}
<section class="card auth-card">
    <h1 class="page-title">{{ trans('auth.login_title') }}</h1>
    <p class="muted">{{ trans('auth.login_subtitle') }}</p>

    {% if error is defined and error %}
        <p class="alert alert--error">{{ error }}</p>
    {% endif %}

    <form method="post" action="/login" class="auth-form">
        <input type="hidden" name="_token" value="{{ csrf_token }}">
        <input type="hidden" name="redirect" value="{{ redirect|default('/') }}">

        <div class="form-group">
            <label for="login-email">{{ trans('auth.email') }}</label>
            <input type="email" id="login-email" name="email" value="{{ email|default('') }}" required autocomplete="username">
        </div>

        <div class="form-group">
            <label for="login-password">{{ trans('auth.password') }}</label>
            <input type="password" id="login-password" name="password" required autocomplete="current-password">
        </div>

        <div class="actions">
            <button type="submit" class="btn btn--primary btn--block">{{ trans('auth.sign_in') }}</button>
        </div>
    </form>

    <p class="auth-card__footer muted">
        {{ trans('auth.no_account') }}
        <a href="/register">{{ trans('auth.create_account') }}</a>
    </p>
</section>
{% endblock %}
