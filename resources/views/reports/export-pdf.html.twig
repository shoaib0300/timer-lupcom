<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
    <meta charset="utf-8">
    <title>{{ trans('reports.export_title') }}</title>
    <style>
        body {
            font-family: DejaVu Sans, sans-serif;
            font-size: 11px;
            color: #111827;
            margin: 24px;
        }

        h1 {
            font-size: 18px;
            margin: 0 0 6px;
        }

        .meta {
            margin: 0 0 16px;
            color: #4b5563;
            line-height: 1.5;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #d1d5db;
            padding: 6px 8px;
            text-align: left;
            vertical-align: top;
        }

        th {
            background: #f3f4f6;
            font-weight: 700;
        }

        .total-row td {
            font-weight: 700;
            background: #f9fafb;
        }

        .muted {
            color: #6b7280;
        }
    </style>
</head>
<body>
    <h1>{{ trans('reports.export_title') }}</h1>
    <p class="meta">
        <strong>{{ trans('common.date') }}:</strong> {{ period_label }}<br>
        <strong>{{ trans('common.project') }}:</strong> {{ project_label }}<br>
        <strong>{{ trans('common.task') }}:</strong> {{ task_label }}<br>
        <span class="muted">{{ trans('reports.export_generated', {date: generated_at}) }}</span>
    </p>

    <table>
        <thead>
            <tr>
                <th>{{ trans('common.date') }}</th>
                <th>{{ trans('common.project') }}</th>
                <th>{{ trans('dashboard.task_reason') }}</th>
                <th>{{ trans('reports.subject') }}</th>
                <th>{{ trans('common.started') }}</th>
                <th>{{ trans('common.ended') }}</th>
                <th>{{ trans('common.duration') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in entries %}
                <tr>
                    <td>{{ format_compact_date(entry.startedAt) }}</td>
                    <td>
                        {% if entry.isGeneral %}
                            {{ trans('common.general') }}
                        {% else %}
                            {{ entry.projectName }}
                        {% endif %}
                    </td>
                    <td>
                        {% if entry.isGeneral %}
                            {{ entry.notes ?: trans('common.general_time') }}
                        {% else %}
                            {{ entry.displayLabel() }}
                        {% endif %}
                    </td>
                    <td>{{ entry.subject ?? '—' }}</td>
                    <td>{{ format_compact_datetime(entry.startedAt) }}</td>
                    <td>{{ entry.endedAt ? format_compact_datetime(entry.endedAt) : '' }}</td>
                    <td>{{ format_clock(entry.durationSeconds) }}</td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7">{{ trans('reports.export_empty') }}</td>
                </tr>
            {% endfor %}
            <tr class="total-row">
                <td colspan="6">{{ trans('common.total') }}</td>
                <td>{{ total_label }} ({{ format_clock(total_seconds) }})</td>
            </tr>
        </tbody>
    </table>
</body>
</html>
