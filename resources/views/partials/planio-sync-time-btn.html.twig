{% if planio_configured %}
    <button
        type="button"
        class="btn btn--ghost btn--sm js-planio-sync-time planio-sync-btn{% if compact|default(false) %} planio-sync-btn--compact{% endif %}{{ class is defined and class ? ' ' ~ class : '' }}"
        data-month="{{ month|default('') }}"
        data-reload="{{ reload|default('1') }}"
        data-feedback-id="{{ feedback_id|default('planio-sync-feedback') }}"
        title="{{ label|default(trans('planio.sync_time')) }}"
        aria-label="{{ label|default(trans('planio.sync_time')) }}"
    >
        {% if compact|default(false) %}
            <svg class="planio-sync-btn__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0 0 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 0 0 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>
            <span class="planio-sync-btn__label">{{ trans('planio.sync_time_short') }}</span>
        {% else %}
            {{ label|default(trans('planio.sync_time')) }}
        {% endif %}
    </button>
{% endif %}
