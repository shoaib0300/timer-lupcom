{% extends 'layouts/base.html.twig' %}

{% block title %}{{ trans('office.title') }}{% endblock %}

{% set active_nav = 'office' %}

{% block content %}
<div class="office-page">
<h1 class="page-title">{{ trans('office.title') }}</h1>
<p class="muted office-page__intro">{{ trans('office.page_intro') }}</p>

<div class="card office-page__today">
    <div class="muted">{{ trans('office.in_office_today') }}</div>
    <div class="stat">{{ format_time(work_today_seconds) }}</div>
</div>

<section class="card office-filter">
    <form method="get" action="/office" class="office-filter__form">
        <div class="form-group">
            <label for="office-from">{{ trans('office.from') }}</label>
            <input type="date" id="office-from" name="from" value="{{ from }}" max="{{ today_date }}">
        </div>
        <div class="form-group">
            <label for="office-to">{{ trans('office.to') }}</label>
            <input type="date" id="office-to" name="to" value="{{ to }}" max="{{ today_date }}">
        </div>
        <div class="form-group office-filter__actions">
            <label>&nbsp;</label>
            <button type="submit" class="btn btn--primary">{{ trans('common.apply_filters') }}</button>
        </div>
    </form>
    <div class="office-filter__summary-row">
        <p class="muted office-filter__summary">
            {{ trans('office.period_summary', {total: period_total}) }}
        </p>
        <div class="office-filter__tools">
            <a href="/office/export?format=csv&amp;{{ export_query }}" class="btn btn--ghost btn--sm">{{ trans('reports.export_csv') }}</a>
            <a href="/office/export?format=pdf&amp;{{ export_query }}" class="btn btn--ghost btn--sm">{{ trans('reports.export_pdf') }}</a>
        </div>
    </div>
</section>

<section class="card">
    <h2>{{ trans('office.daily_overview') }}</h2>
    {% if daily_overview is empty %}
        <p class="muted">{{ trans('office.no_days') }}</p>
    {% else %}
        <table class="table office-daily-table">
            <thead>
                <tr>
                    <th>{{ trans('common.date') }}</th>
                    <th>{{ trans('office.in_office') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for day in daily_overview %}
                    <tr>
                        <td>{{ format_compact_date(day.date) }}</td>
                        <td>{{ format_time(day.work_seconds) }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>
</div>
{% endblock %}
